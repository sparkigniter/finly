# ---- Cloud Run Job image (Cron Worker) ----
# Runs queue_consumer.py on a schedule via Cloud Scheduler.
# Pulls messages from Pub/Sub, processes them, and exits cleanly.
FROM python:3.11-slim
 
WORKDIR /app
 
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    && rm -rf /var/lib/apt/lists/*
 
COPY app/backend/requirements.txt ./requirements.txt
RUN pip install --no-cache-dir -r requirements.txt
 
COPY app/ ./app/
 
# Runs once and exits — perfect for a cron job
CMD ["python", "-m", "app.backend.cron.queue_consumer", "protfolio-analysis-queue"]